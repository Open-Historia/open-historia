# Android build (the app: this same web bundle inside a Capacitor WebView).
# Loaded ONLY by `vite build --mode android` (npm run build:android).
#
# Everything the game needs is on the phone: the library lives in IndexedDB, and
# the world map — the three pmtiles archives, the regions GeoJSON and the editor
# seeds — ships inside the APK under /assets (mobile/scripts/stage-www.mjs): the
# same files, from the same list (scripts/map-assets.web.json), that the website
# carries under its own /assets.
VITE_OH_WEB=1
VITE_OH_NATIVE=1

# The one thing that stays on the network, opt-in from inside the game: the
# community hub (GitHub-hosted scenarios need the SSRF-guarded proxy, since
# GitHub sends no CORS headers).
VITE_OH_HUB_URL=https://open-historia-registry.nichojkrol.workers.dev
