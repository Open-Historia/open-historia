# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-web
# The Android bundle (npm run build:android) and the verified map data
# mobile/scripts/stage-map-assets.mjs downloads for it.
dist-android
mobile/map-cache
# Assembled by scripts/assemble-site.mjs from dist-web + site/. Build output, and
# big enough that a stray `git add -A` commits a whole copy of the website.
dist-site
dist-ssr
# electron-builder output (the packaged app + installer)
release
*.local

# Web-mode seed (generated from server/seed/default by
# scripts/seed-web-defaults.mjs at `npm run build:web`; never committed, never
# in the local build).
/src/runtime/web/generated/

# Vendored Fantasy Map Generator (fetched at runtime by scripts/fetch-fmg.mjs)
/fmg/
# Runtime state only. The built-in scenario's seed lives in server/seed/ and is
# copied in by the server (libraryStore.js); the stock world under
# server/data/stock/ is downloaded by scripts/fetch-map-assets.mjs.
server/data/

# Large world-map binaries — hosted as GitHub Release assets and downloaded by
# scripts/fetch-map-assets.mjs, not committed (they used to be in Git LFS, whose
# free bandwidth a few installs exhausted). See scripts/map-assets.json.
/public/assets/*.pmtiles
/public/assets/regions-seed.geojson
/public/assets/cities-seed.json
.key
CLAUDE.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Content-node runtime store (hash-named blobs, populated by scripts/populate-node.mjs)
/node-content/

# Offline root signing PRIVATE key — never commit
/trust/*.key.pem
# generated per release build by the desktop workflow
electron/build-id.json
# generated by scripts/stamp-channel.mjs; absent means the stable build
electron/channel.json
