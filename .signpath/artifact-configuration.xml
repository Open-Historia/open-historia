<?xml version="1.0" encoding="utf-8"?>
<!--
  Open Historia: SignPath artifact configuration for the Windows desktop app.
  Paste this into the SignPath project (Artifact configurations); SignPath reads
  it from there, not from the repository. docs/code-signing.md has the steps.

  One configuration serves both signing requests the stable release workflow
  sends (.github/workflows/desktop-installer.yml). Each request is a GitHub
  artifact, which SignPath receives as a zip:

    1. the packed app's own programs, taken from release/win-unpacked:
         Open Historia.exe at the root, and the system speech program under
         resources/app.asar.unpacked/electron/speech/
    2. the installer built from those signed files:
         Open-Historia-Setup.exe at the root

  Only files built from this repository are signed. Electron's own DLLs stay
  as Electron ships them (SignPath Foundation: upstream binaries are not ours
  to sign), and they are not in the request at all.

  SignPath Foundation requires every signed file's metadata to be set and
  enforced: the product name is the project's name, and the product version is
  the same in every file of a build. The workflow passes that build's version
  (package.json's, stamped by the workflow) as the `version` parameter, and it
  checks the files itself before sending them (scripts/check-signing-metadata.ps1).
  The beta (productName "Open Historia Beta") is therefore not signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Open Historia" product-version="${version}">
      <!-- The app (request 1) or the installer (request 2): exactly one program at the root. -->
      <include path="*.exe" min-matches="1" max-matches="1" />
      <!-- The system speech program; none in the installer request. -->
      <include path="resources/app.asar.unpacked/**/*.exe" min-matches="0" max-matches="unbounded" />
      <!-- Native modules, should the app ever carry one of its own. -->
      <include path="resources/app.asar.unpacked/**/*.node" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
