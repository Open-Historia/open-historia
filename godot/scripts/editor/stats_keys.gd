static var _pattern: RegEx


static func pattern() -> RegEx:
	if _pattern == null:
		_pattern = RegEx.create_from_string(PATTERN)
	return _pattern


static func is_key(value: String) -> bool:
	return pattern().search(value) != null


static func to_key(value: String) -> String:
	var text := value.strip_edges()
	var spaced := ""
	for index in range(text.length()):
		var code := text.unicode_at(index)
		if (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122):
			spaced += String.chr(code)
		elif FOLD.has(code):
			spaced += str(FOLD[code])
		else:
			spaced += " "
	var words: PackedStringArray = []
	for word in spaced.split(" ", false):
		words.append(word)
	if words.is_empty():
		return ""
	var key := ""
	for index in range(words.size()):
		var lower := words[index].to_lower()
		key += lower if index == 0 else lower.substr(0, 1).to_upper() + lower.substr(1)
	key = key.substr(0, 40)
	var first := key.unicode_at(0) if not key.is_empty() else 0
	if not ((first >= 65 and first <= 90) or (first >= 97 and first <= 122)):
		key = ("stat" + key).substr(0, 40)
	return key if is_key(key) else ""
