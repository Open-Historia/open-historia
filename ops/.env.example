# Open Historia — settings for ops/docker-compose.yml © 2026 Nicholas Krol, AGPL-3.0-or-later (see LICENSE).
#
# Copy to ops/.env, fill in, and keep it private:
#   cp .env.example .env && chmod 600 .env
# ops/.gitignore keeps .env out of git. server-mp checks every value it reads
# (server-mp/src/config.js) and refuses to start on one it cannot use, naming
# it; coturn refuses to start without a TURN_SECRET and a TURN_EXTERNAL_IP.

# The server's public name: a DNS A record (and AAAA, if the VM has IPv6)
# pointing at the VM's public address. Caddy gets its certificate for it, and
# the game is built with VITE_OH_MP_SERVER=https://<this name>.
MP_DOMAIN=mp.example.org

# The secret server-mp makes TURN credentials with and coturn checks them
# with. Both read it from this file, so they always agree. Make it with
#   openssl rand -hex 32
# and paste it after the "=". Changing it cuts off every credential already
# handed out (each lasts TURN_TTL_SECONDS at most); clients ask again.
TURN_SECRET=
# What clients are told to use: TURN over UDP and TCP on 3478, and over TLS
# on 5349. Leave the turns: URL out until coturn has its certificate
# (README.md, "TURN over TLS").
TURN_URLS=turn:mp.example.org:3478?transport=udp,turn:mp.example.org:3478?transport=tcp,turns:mp.example.org:5349?transport=tcp
# How long a credential lasts (60 to 3600 seconds). A connection that must
# outlive it asks server-mp again and restarts ICE with the new one.
TURN_TTL_SECONDS=900
# Required. The VM's public IPv4 address, then its private one:
#   <public>/<private>      for example 203.0.113.10/10.0.0.12
# (just <public> on a VM that holds its public address itself). Oracle Cloud
# gives the VM a private address and maps the public one onto it; without
# this coturn would tell clients the private one. The public address is also
# the only one the relay may send to (turnserver.conf, "What it may reach").
TURN_EXTERNAL_IP=

# The origins whose pages may connect: the web game, the Android app, the
# desktop app (it serves itself on whichever local port was free), and local
# development. Exact origins, or :* for any port.
ALLOWED_ORIGINS=https://openhistoria.com,http://app.paxhistoria,http://localhost:*,http://127.0.0.1:*

# Limits. An address is an IPv4 address or an IPv6 /64, and an IPv6 /48 may
# hold four addresses' worth. (MAX_MEMORY_MB is set in docker-compose.yml, to
# match the container's memory limit.)
MAX_ROOMS=500
MAX_ROOMS_PER_IP=3
MAX_CONNECTIONS_PER_IP=10
MAX_CONNECTIONS=1000
