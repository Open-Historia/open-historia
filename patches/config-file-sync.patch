+const CONFIG_FILE = process.env.OPEN_HISTORIA_CONFIG || path.join(USER_ROOT, "config.json");
+
+const setupConfigSync = (win) => {
+  win.webContents.on("dom-ready", async () => {
+    try {
+      if (fs.existsSync(CONFIG_FILE)) {
+        const raw = fs.readFileSync(CONFIG_FILE, "utf8");
+        const parsed = JSON.parse(raw);
+        const statements = [];
+        for (const [key, value] of Object.entries(parsed)) {
+          const serialized = typeof value === "string" ? value : JSON.stringify(value);
+          statements.push(`localStorage.setItem(${JSON.stringify(key)}, ${JSON.stringify(serialized)});`);
+        }
+        if (statements.length > 0) {
+          await win.webContents.executeJavaScript(`(() => {
+            ${statements.join("\n")}
+            window.dispatchEvent(new Event("storage"));
+          })()`);
+          console.log(`[config-sync] Injected configuration from ${CONFIG_FILE}`);
+        }
+      } else {
+        setTimeout(async () => {
+          try {
+            if (win.isDestroyed()) return;
+            const dumped = await win.webContents.executeJavaScript(`(() => {
+              const keys = ["ai_connections", "ai_fallback_list", "ai_task_picks"];
+              const out = {};
+              for (const k of keys) {
+                const val = localStorage.getItem(k);
+                if (val) {
+                  try { out[k] = JSON.parse(val); } catch { out[k] = val; }
+                }
+              }
+              return JSON.stringify(out, null, 2);
+            })()`);
+            if (dumped && dumped !== "{}") {
+              fs.writeFileSync(CONFIG_FILE, dumped, "utf8");
+              console.log(`[config-sync] Exported initial configuration to ${CONFIG_FILE}`);
+            }
+          } catch (e) {
+            console.warn("[config-sync] Failed to export initial config:", e);
+          }
+        }, 1500);
+      }
+    } catch (err) {
+      console.warn(`[config-sync] Error with config file ${CONFIG_FILE}:`, err);
+    }
+  });
+};
